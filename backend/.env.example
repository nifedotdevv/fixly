PORT=5000
NODE_ENV=development
# Code accepts MONGO_URI as a fallback, MONGODB_URI is checked first
MONGODB_URI=mongodb://127.0.0.1:27017/fixly-backend
JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRES_IN=1d
# Comma-separated browser origins allowed to call the API (e.g. the Vite dev server)
CLIENT_ORIGIN=http://localhost:5173
# Uploads are served from this Cloudinary folder when configured
CLOUDINARY_FOLDER=fixly
# Optional rate-limit overrides (requests per window)
# AUTH_RATE_LIMIT_MAX=10
# API_RATE_LIMIT_MAX=300


# Cloudinary (multer-storage-cloudinary uploads)
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

# Service request response deadlines: 15 minutes to 7 days from submission.
REQUEST_RESPONSE_MIN_MINUTES=15
REQUEST_RESPONSE_MAX_MINUTES=10080
# Unpaid reservation duration, capped by appointment start (and quote expiry for repairs).
INSPECTION_PAYMENT_MINUTES=30
REPAIR_DEPOSIT_MINUTES=1440
# Internal payment simulator: disabled by default, refused outside development/test.
ENABLE_PAYMENT_SIMULATION=false

# Pending lifecycle cascades are repaired in bounded batches (20 accounts per pass).
# Locks never expire automatically; use lifecycle:inspect for verified recovery.
# LIFECYCLE_RECOVERY_INTERVAL_MS=60000

# Background avatar cleanup sweep interval (ms) and batch size
# AVATAR_CLEANUP_INTERVAL_MS=300000
# AVATAR_CLEANUP_BATCH_SIZE=20
# AVATAR_CLEANUP_RETRY_MS=300000
# AVATAR_CLEANUP_CLAIM_MS=60000

# Recovery window for self-deleted accounts. Afterward a fresh registration
# requires previousPassword; admin-deactivated accounts stay reserved.
# SOFT_DELETE_GRACE_DAYS=30
