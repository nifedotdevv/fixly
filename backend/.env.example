PORT=5000
NODE_ENV=development
# Code accepts MONGO_URI as a fallback, MONGODB_URI is checked first
MONGODB_URI=mongodb://127.0.0.1:27017/fixly-backend
JWT_SECRET=replace-with-long-random-secret
JWT_EXPIRES_IN=12h
# Comma-separated browser origins allowed to call the API (e.g. the Vite dev server)
CLIENT_ORIGIN=http://localhost:5173
# Uploads are served from this Cloudinary folder when configured
CLOUDINARY_FOLDER=fixly
# Optional rate-limit overrides (requests per window)
# AUTH_RATE_LIMIT_MAX=10
# API_RATE_LIMIT_MAX=300
# Behind a reverse proxy, set the hop count (e.g. 1) or a trusted address list so
# rate limits see real client IPs. Leave empty when not behind a proxy.
TRUST_PROXY=


# Cloudinary (multer-storage-cloudinary uploads)
CLOUDINARY_CLOUD_NAME=replace-me
CLOUDINARY_API_KEY=replace-me
CLOUDINARY_API_SECRET=replace-me

# Service request response deadlines: 15 minutes to 7 days from submission.
REQUEST_RESPONSE_MIN_MINUTES=15
REQUEST_RESPONSE_MAX_MINUTES=10080
# Unpaid reservation duration, capped by appointment start (and quote expiry for repairs).
INSPECTION_PAYMENT_MINUTES=30
REPAIR_DEPOSIT_MINUTES=1440
# Internal payment simulator: disabled by default, refused outside development/test.
ENABLE_PAYMENT_SIMULATION=false

# Pending lifecycle cascades are repaired in bounded batches (20 accounts per pass).
# Locks never expire automatically; use lifecycle:inspect for verified recovery.
# LIFECYCLE_RECOVERY_INTERVAL_MS=60000
# Optional service request expiry materialization sweep interval (ms)
# REQUEST_EXPIRY_SWEEP_INTERVAL_MS=60000

# Background avatar cleanup sweep interval (ms) and batch size
# AVATAR_CLEANUP_INTERVAL_MS=300000
# AVATAR_CLEANUP_BATCH_SIZE=20
# AVATAR_CLEANUP_RETRY_MS=300000
# AVATAR_CLEANUP_CLAIM_MS=60000

# Recovery window for self-deleted accounts. Afterward a fresh registration
# requires previousPassword; admin-deactivated accounts stay reserved.
# SOFT_DELETE_GRACE_DAYS=30

# Credential email delivery: Mailtrap Email Sandbox for development.
# Copy your inbox's SMTP credentials; Sandbox captures rather than delivers mail.
# SMTP_HOST=sandbox.smtp.mailtrap.io
# SMTP_PORT=2525
# SMTP_USER=your-sandbox-username
# SMTP_PASSWORD=your-sandbox-password
# MAIL_FROM=Fixly <no-reply@fixly.test>
# PASSWORD_RESET_URL=http://localhost:5173/reset-password
# EMAIL_CHANGE_URL=http://localhost:5173/confirm-email-change
# Email verification link target (token is appended as #token=...; link valid 24 hours).
# Required for verification mail delivery; if unset, registration still succeeds and the user can resend later.
# EMAIL_VERIFY_URL=http://localhost:5173/verify-email
#
# Alternative: Gmail SMTP (real delivery; ~500 messages/day). Requires 2-Step
# Verification and a 16-character App Password (spaces removed), not the
# account password. MAIL_FROM must be the same Gmail address.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=your-address@gmail.com
# SMTP_PASSWORD=your-app-password
# MAIL_FROM=Fixly <your-address@gmail.com>
#
# Verify settings with `npm run mail:check` (add `-- --to you@example.com`
# to send one test message).

# Test database server for `npm test` and scripts/simulate-request-payment.js
# (takes precedence over MONGODB_URI). Tests create and drop a unique
# fixly-test-<uuid> database; defaults to mongodb://127.0.0.1:27017 if unset.
# MONGODB_URI_TEST=mongodb://127.0.0.1:27017
#
# Local SMTP catchers only: when true, NODE_ENV is not production and SMTP_HOST is
# localhost/127.0.0.1/::1, TLS is not required. Never effective otherwise.
# SMTP_ALLOW_INSECURE_LOCAL=false
