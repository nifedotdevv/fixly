    "express": "^5.2.1",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "http-status": "^2.1.0",
    "joi": "^18.3.2",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.11.1",
    "morgan": "^1.12.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.6.0"
